Requires: absl_common_policy_traits = head, absl_compare = head, absl_compressed_tuple = head, absl_config = head, absl_container_common = head, absl_container_memory = head, absl_cord = head, absl_core_headers = head, absl_hardening = head, absl_layout = head, absl_memory = head, absl_raw_logging_internal = head, absl_string_view = head, absl_throw_delegate = head, absl_type_traits = head, absl_weakly_mixed_integer = head
