prefix=D:/git-workspace/BlackSwan/thirdparty/protobuf-36.1/win-x64
exec_prefix=${prefix}
libdir=D:/git-workspace/BlackSwan/thirdparty/protobuf-36.1/win-x64/lib
includedir=D:/git-workspace/BlackSwan/thirdparty/protobuf-36.1/win-x64/include

Name: absl_log_internal_format
Description: Abseil log_internal_format library
URL: https://abseil.io/
Version: head
Requires: absl_config = head, absl_core_headers = head, absl_log_internal_append_truncated = head, absl_log_internal_config = head, absl_log_internal_globals = head, absl_log_severity = head, absl_span = head, absl_str_format = head, absl_string_view = head, absl_strings = head, absl_time = head
Libs: -L${libdir}  -labsl_log_internal_format -ignore:4221
Cflags: -I${includedir} /W3 /bigobj /wd4005 /wd4068 /wd4180 /wd4503 /wd4800 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE
